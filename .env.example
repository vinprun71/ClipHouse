# SQLite database location.
# Bare metal default: file:./data/cliphouse.db
# Docker default:     file:/app/data/cliphouse.db
DATABASE_URL="file:./data/cliphouse.db"

# Used only to print the correct first-run setup link.
CLIPHOUSE_PUBLIC_URL="http://localhost:3000"

# Optional. Defaults to ./data/setup-token.
CLIPHOUSE_SETUP_TOKEN_FILE="./data/setup-token"
